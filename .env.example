# ==============================================================================
# BANSAL FOODS - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# RULE: Never commit real secrets. Use __SET_ME__ for unconfigured values.
# In production, all placeholders are validated and will block deployment.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
# Primary PostgreSQL connection
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/bansal_foods

# Redis Instance 1: Cache and Rate Limiting (configured with allkeys-lru)
REDIS_CACHE_URL=redis://localhost:6379

# Redis Instance 2: BullMQ Queues and Distributed Locks (configured with noeviction)
REDIS_QUEUE_URL=redis://localhost:6380

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# Minimum 32 characters in production. Generate using: openssl rand -base64 32
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=development_jwt_access_secret_min_32_chars_long!
JWT_REFRESH_SECRET=development_jwt_refresh_secret_min_32_chars_long!
COOKIE_SECRET=development_cookie_secret_min_32_chars_long!
CSRF_SECRET=development_csrf_secret_min_32_chars_long!

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay)
# Replace with test credentials from Razorpay Dashboard in development/staging.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test___SET_ME__
RAZORPAY_KEY_SECRET=__SET_ME__
RAZORPAY_WEBHOOK_SECRET=__SET_ME__

# ------------------------------------------------------------------------------
# OBJECT STORAGE (S3-compatible: AWS S3 or Cloudflare R2 or MinIO)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=bansal-foods-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
NEXT_PUBLIC_CDN_URL=http://localhost:9000/bansal-foods-media

# ------------------------------------------------------------------------------
# NOTIFICATIONS (Adapters for Email, SMS, WhatsApp)
# ------------------------------------------------------------------------------
# Email (SMTP / Mailpit for local dev, AWS SES / Resend in prod)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Bansal Foods <orders@bansalfoods.example.com>"

# SMS (DLT-registered India SMS Gateway: MSG91 / Twilio)
SMS_PROVIDER=log
SMS_AUTH_KEY=__SET_ME__
SMS_SENDER_ID=__SET_ME__

# WhatsApp Business Cloud API / BSP
WHATSAPP_PROVIDER=log
WHATSAPP_API_TOKEN=__SET_ME__
WHATSAPP_PHONE_NUMBER_ID=__SET_ME__

# ------------------------------------------------------------------------------
# CORS & FRONTEND URLS
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test___SET_ME__

# ------------------------------------------------------------------------------
# OBSERVABILITY & LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
